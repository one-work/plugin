.devices_summary {
  margin-top: 30px;
  padding: 0.75rem;
}

.px-3 {
  padding-left: 0.75rem;
  padding-right: 0.75rem;
}

.device_list {
  height: 8rem;
  margin-top: 0;
  margin-left: 0.75rem;
  margin-right: 0.75rem;
  border: 1px solid #EEE;
  border-radius: 5px;
  width: auto;
}

.device_item {
  display: flex;
  border-bottom: 1px solid #EEE;
  padding: 10px;
  color: #666;
}

.device_item__left {
  flex-grow: 1;
}

.device_item_hover {
  background-color: rgba(0, 0, 0, .1);
}

.weui-badge {
  color: gray;
  align-items: center;
  font-size: 0.8rem;
  border-radius: 4px;
  display: inline-flex;
  height: 2em;
  justify-content: center;
  line-height: 1.5;
  margin-left: 0.5rem;
  padding-left: 0.75em;
  padding-right: 0.75em;
  white-space: nowrap;
}
