.devices_summary {
  margin-top: 30px;
  padding: 10px;
  font-size: 16px;
}

.device_list {
  height: 8rem;
  margin: 15px 10px;
  margin-top: 0;
  border: 1px solid #EEE;
  border-radius: 5px;
  width: auto;
}

.device_item {
  display: flex;
  border-bottom: 1px solid #EEE;
  padding: 10px;
  color: #666;
}

.device_item__left {
  flex-grow: 1;
}