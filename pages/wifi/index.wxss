page {
  color: #333;
}

.text-centered {
  text-align: center;
  margin-top: 0.75rem;
}

.connected_info {
  background-color: #F0F0F0;
  padding: 0.75rem;
  margin: 15px 0.75rem;
  border-radius: 6px;
  margin-bottom: env(safe-area-inset-bottom);
  font-size: 14px;
  min-height: 100px;
}

.connected_info button {
  margin-top: 15px;
}

.connected_info input + input {
  margin-top: 15px;
}

.px-4 {
  padding-left: 1rem;
  padding-right: 1rem;
}

.mb-4 {
  margin-bottom: 1rem;
}
