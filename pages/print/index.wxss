page {
  color: #333;
}

input {
  border: 1px solid #ccc;
  padding: 5px 10px;
}

.connected_info {
  background-color: #F0F0F0;
  padding: 10px;
  padding-bottom: 20px;
  margin: 15px 10px;
  margin-bottom: env(safe-area-inset-bottom);
  font-size: 14px;
  min-height: 100px;
}

.connected_info button {
  margin-top: 15px;
}

.connected_info input + input {
  margin-top: 15px;
}

.device_item_hover {
  background-color: rgba(0, 0, 0, .1);
}

.px-4 {
  padding-left: 1rem;
  padding-right: 1rem;
}

.mb-4 {
  margin-bottom: 1rem;
}

.weui-badge {
  color: gray;
  align-items: center;
  font-size: 0.8rem;
  border-radius: 4px;
  display: inline-flex;
  height: 2em;
  justify-content: center;
  line-height: 1.5;
  margin-left: 0.5rem;
  padding-left: 0.75em;
  padding-right: 0.75em;
  white-space: nowrap;
}
